<Window x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Contacts" Height="450" Width="900"
        MinHeight="350" MinWidth="700">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="3"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая колонка -->
        <Border Grid.Column="0" Background="#F8F8F8">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBox Grid.Row="0"
                         Margin="3"
                         IsReadOnly="True"
                         Text="Find:" />

                <ListBox Grid.Row="1"
                         Margin="3"
                         ItemsSource="{Binding Contacts}"
                         SelectedItem="{Binding SelectedContact, Mode=TwoWay}"
                         DisplayMemberPath="Name"/>

                <Grid Grid.Row="2"
                      Margin="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Margin="3"
                            Height="25"
                            Content="Add"
                            Command="{Binding AddCommand}" />

                    <Button Grid.Column="1"
                            Margin="3"
                            Height="25"
                            Content="Edit"
                            Command="{Binding EditCommand}" />

                    <Button Grid.Column="2"
                            Margin="3"
                            Height="25"
                            Content="Remove"
                            Command="{Binding RemoveCommand}" />
                </Grid>
            </Grid>
        </Border>

        <!-- Разделитель -->
        <GridSplitter Grid.Column="1"
                      Width="3"
                      Background="White"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch" />

        <!-- Правая колонка -->
        <Border Grid.Column="2" Background="White">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Плейсхолдер фото -->
                <Border Grid.Row="0"
                        Grid.RowSpan="6"
                        Grid.Column="0"
                        Width="100"
                        Height="100"
                        Margin="3"
                        Background="#F2F2F2"
                        BorderBrush="#D0D0D0"
                        BorderThickness="1"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top">
                    <Viewbox>
                        <TextBlock Text="👤"
                                   Foreground="#C0C0C0"
                                   FontSize="40"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Viewbox>
                </Border>

                <TextBlock Grid.Row="0" Grid.Column="1" Margin="3" Text="Name:"/>
                <TextBox Grid.Row="1" Grid.Column="1" Margin="3"
                         Text="{Binding EditorName, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="{Binding IsReadOnly}"/>

                <TextBlock Grid.Row="2" Grid.Column="1" Margin="3" Text="Phone Number:"/>
                <TextBox Grid.Row="3" Grid.Column="1" Margin="3"
                         Text="{Binding EditorPhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="{Binding IsReadOnly}"/>

                <TextBlock Grid.Row="4" Grid.Column="1" Margin="3" Text="Email:"/>
                <TextBox Grid.Row="5" Grid.Column="1" Margin="3"
                         Text="{Binding EditorEmail, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="{Binding IsReadOnly}"/>

                <Button Grid.Row="7" Grid.Column="1"
                        Margin="3"
                        Width="75"
                        Height="25"
                        HorizontalAlignment="Left"
                        Content="Apply"
                        Command="{Binding ApplyCommand}"
                        Visibility="{Binding IsApplyVisible,
                                             Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
        </Border>
    </Grid>
</Window>